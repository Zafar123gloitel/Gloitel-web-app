{
// ────────────────────────────────
// ✨ Emmet
// ────────────────────────────────
"emmet.includeLanguages": {
  "plaintext": "html",
  "javascript": "javascriptreact",
  "typescript": "typescriptreact"
},

// ────────────────────────────────
// ✨ Editor & Performance
// ────────────────────────────────
"editor.fontSize": 16,
"editor.fontFamily": "Fira Code, Consolas, 'Courier New', monospace",
"editor.fontLigatures": true,
"editor.fontWeight": "500",
"editor.lineHeight": 22,

"editor.cursorBlinking": "smooth",
"editor.cursorSmoothCaretAnimation": "on",
"editor.cursorStyle": "line",
"editor.cursorWidth": 2,

"editor.minimap.enabled": false,
"editor.renderWhitespace": "boundary",
"editor.wordWrap": "on",
"editor.smoothScrolling": true,
"editor.largeFileOptimizations": true,

"editor.bracketPairColorization.enabled": true,
"editor.guides.bracketPairs": "active",

"editor.stickyScroll.enabled": true,
"editor.stickyScroll.maxLineCount": 5,

"editor.linkedEditing": true,
"editor.tabSize": 2,
"editor.insertSpaces": true,
"editor.snippets.codeActions.enabled": true,

"editor.suggestSelection": "first",
"editor.snippetSuggestions": "top",

"editor.formatOnSave": true,
"editor.formatOnSaveMode": "file",
"editor.formatOnPaste": true,
"editor.formatOnType": true,
"editor.acceptSuggestionOnEnter": "on",

// ────────────────────────────────
// ✨ Formatter (Prettier only)
// ────────────────────────────────
"editor.defaultFormatter": "esbenp.prettier-vscode",

// ────────────────────────────────
// ✨ Prettier
// ────────────────────────────────
"prettier.enable": true,
"prettier.requireConfig": true,
"prettier.singleQuote": true,
"prettier.semi": true,
"prettier.trailingComma": "all",
"prettier.printWidth": 100,
"prettier.arrowParens": "avoid",
"prettier.jsxSingleQuote": true,
"prettier.endOfLine": "lf",
"prettier.quoteProps": "as-needed",
"prettier.bracketSpacing": true,
"prettier.useTabs": false,
"prettier.embeddedLanguageFormatting": "auto",
"prettier.htmlWhitespaceSensitivity": "strict",

// ────────────────────────────────
// ✨ ESLint (optimized)
// ────────────────────────────────
"eslint.enable": true,
"eslint.format.enable": true,
"eslint.run": "onType",
"eslint.validate": [
  "javascript",
  "typescript",
  "javascriptreact",
  "typescriptreact",
  "json",
  "html"
],
"eslint.codeAction.showDocumentation": {
  "enable": true
},
"eslint.workingDirectories": [{ "mode": "auto" }],

"eslint.codeActionsOnSave.mode": "all",
"editor.codeActionsOnSave": {
  "source.fixAll.eslint": "explicit",
  "source.fixAll.prettier": "explicit",
  "source.addMissingImports": "explicit",
  "source.removeUnusedImports": "explicit",
},

// ────────────────────────────────
// ✨ TypeScript / JavaScript (modern API)
// ────────────────────────────────
"js/ts.tsdk.path": "node_modules/typescript/lib",
"js/ts.updateImportsOnFileMove.enabled": "always",

// ────────────────────────────────
// ✨ Terminal
// ────────────────────────────────
"terminal.integrated.cursorBlinking": true,
"terminal.integrated.tabs.enabled": true,
"terminal.integrated.fontSize": 12,
"terminal.integrated.smoothScrolling": true,
"terminal.integrated.defaultProfile.osx": "zsh",
// "terminal.integrated.defaultProfile.windows": "Git Bash",
// "terminal.integrated.defaultProfile.linux": "bash",

// ────────────────────────────────
// ✨ AI
// ────────────────────────────────
"editor.inlineSuggest.enabled": true,
"chat.agent.enabled": true,
"chat.mcp.discovery.enabled": {
  "claude-desktop": true,
  "windsurf": true,
  "cursor-global": true,
  "cursor-workspace": true
},

// ────────────────────────────────
// ✨ UI / Workbench
// ────────────────────────────────
"workbench.startupEditor": "none",
"workbench.editor.enablePreview": false,
"workbench.editor.highlightModifiedTabs": true,
"workbench.tree.renderIndentGuides": "always",

"workbench.iconTheme": "material-icon-theme",
"workbench.colorTheme": "Monokai++",
"workbench.tree.indent": 16,
"workbench.editor.decorations.colors": true,
"workbench.colorCustomizations": {
  "activityBar.background": "#000307",
  "activityBar.foreground": "#ffffff",
  "statusBar.background": "#020c1a",
  "statusBar.foreground": "#ffffff",
  "tree.indentGuidesStroke": "#ff0000",
  "tree.inactiveIndentGuidesStroke": "#51b8e1"
},

// ────────────────────────────────
// ✨ Files & Explorer
// ────────────────────────────────
"files.associations": {
  ".env*": "dotenv"
},

"explorer.compactFolders": false,
"explorer.confirmDelete": false,
// "breadcrumbs.enabled": true,

// ────────────────────────────────
// ✨ Tailwind
// ────────────────────────────────
"tailwindCSS.experimental.classRegex": [
  ["clsx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"],
  ["cva\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
],

// ────────────────────────────────
// ✨ Git
// ────────────────────────────────
"git.enableSmartCommit": true,
"git.autofetch": true,
"git.confirmSync": false,

// ────────────────────────────────
// ✨ Diff Editor
// ────────────────────────────────
"diffEditor.ignoreTrimWhitespace": false,
"diffEditor.renderSideBySide": false,

// ────────────────────────────────
// ✨ Extensions / Misc
// ────────────────────────────────
"liveServer.settings.donotShowInfoMsg": true,
"errorLens.enabled": true,

// 🔐 Security
"security.workspace.trust.untrustedFiles": "prompt",
"chat.viewSessions.orientation": "stacked",
"terminal.integrated.enableMultiLinePasteWarning": "never",
"search.searchView.keywordSuggestions": true,
"explorer.confirmDragAndDrop": false,
"github.copilot.enable": {
  "*": true,
  "plaintext": false,
  "markdown": false,
  "scminput": false,
  "typescript": true,
  "typescriptreact": true
},
"diffEditor.maxComputationTime": 0,
"terminal.integrated.allowedLinkSchemes": [
  "file",
  "http",
  "https",
  "mailto",
  "vscode",
  "vscode-insiders",
  "docker-desktop"
],
"githubPullRequests.pullBranch": "never",
"yaml.disableSchemaDetection": [
  "**/.github/workflows/*.yml",
  "**/.github/workflows/*.yaml",
  "**/.gitea/workflows/*.yml",
  "**/.gitea/workflows/*.yaml",
  "**/.forgejo/workflows/*.yml",
  "**/.forgejo/workflows/*.yaml"
],
"chat.tips.enabled": false,
"github.copilot.nextEditSuggestions.enabled": false,
"githubPullRequests.createOnPublishBranch": "never",
}